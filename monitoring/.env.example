# Monitoring EC2 Docker Compose settings.
# Copy to .env on the Monitoring EC2 and fill actual values there.
# Do not commit real secrets.

# App EC2 private IP or private DNS plus port.
BOBFULL_BACKEND_METRICS_TARGET=10.0.0.10:8080

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=http://monitoring.example.internal:3000

# Slack Incoming Webhook URL for the monitoring channel.
GRAFANA_SLACK_WEBHOOK_URL=

# Images can be pinned after the first Monitoring EC2 verification.
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana-oss:latest
