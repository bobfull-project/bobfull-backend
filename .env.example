# Docker Compose와 Spring Boot 로컬 실행에 필요한 환경변수 예시입니다.
# 실제 비밀값은 작성하거나 커밋하지 않습니다.

# Docker Compose MySQL 컨테이너 설정
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=bobfull
MYSQL_USER=bobfull
MYSQL_PASSWORD=change-me
MYSQL_PORT=3307

# Spring Boot local Profile 실행 설정
APP_PORT=8080
DB_URL=jdbc:mysql://localhost:3307/bobfull
DB_USERNAME=bobfull
DB_PASSWORD=change-me
JPA_DDL_AUTO=update
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Docker Compose Redis 컨테이너·Spring Boot local Profile 공용 설정
REDIS_HOST=localhost
REDIS_PORT=6379
AUTH_REFRESH_TOKEN_EXPIRATION_SECONDS=1209600

# PortOne V2 서버 연동 설정
PORTONE_API_SECRET=
PORTONE_CHANNEL_KEY=
PORTONE_STORE_ID=
PORTONE_WEBHOOK_SECRET=

# 결제 만료 스케줄러 설정
PAYMENT_EXPIRATION_ENABLED=true
PAYMENT_EXPIRATION_FIXED_DELAY=60s
PAYMENT_EXPIRATION_BATCH_SIZE=100
PAYMENT_REFUND_RECONCILIATION_ENABLED=true
PAYMENT_REFUND_RECONCILIATION_FIXED_DELAY=5m
PAYMENT_REFUND_RECONCILIATION_MINIMUM_AGE=10m
PAYMENT_REFUND_RECONCILIATION_RECHECK_DELAY=5m
PAYMENT_REFUND_RECONCILIATION_BATCH_SIZE=20

# AWS V1 배포 연동 예시
AWS_REGION=ap-northeast-2
S3_IMAGE_BUCKET=
S3_IMAGE_UPLOAD_URL_EXPIRATION=5m
S3_IMAGE_GET_URL_EXPIRATION=5m

# 예약 결과(확정·인원 미달 취소) 이메일 알림 설정
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
NOTIFICATION_EMAIL_FROM_ADDRESS=no-reply@bobfull.com
