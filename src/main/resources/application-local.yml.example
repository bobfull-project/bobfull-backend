# Spring Boot 로컬 실행용 설정 예시입니다.
# 이 파일을 application-local.yml로 복사한 뒤 사용하세요.
# 실제 DB 접속 정보는 환경변수로 주입합니다.

spring:
  config:
    import: optional:file:.env[.properties]

  datasource:
    url: ${DB_URL}
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: ${JPA_DDL_AUTO:update}
    open-in-view: false
    properties:
      hibernate:
        format_sql: true

  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}

jwt:
  secret: ${JWT_SECRET}
  access-token-expiration-seconds: ${JWT_ACCESS_TOKEN_EXPIRATION_SECONDS:3600}

auth:
  refresh-token:
    expiration-seconds: ${AUTH_REFRESH_TOKEN_EXPIRATION_SECONDS:1209600}

cors:
  allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:5173}

portone:
  api-secret: ${PORTONE_API_SECRET}
  channel-key: ${PORTONE_CHANNEL_KEY:}
  store-id: ${PORTONE_STORE_ID}
  webhook-secret: ${PORTONE_WEBHOOK_SECRET:}

payment:
  expiration:
    enabled: ${PAYMENT_EXPIRATION_ENABLED:true}
    fixed-delay: ${PAYMENT_EXPIRATION_FIXED_DELAY:60s}
    batch-size: ${PAYMENT_EXPIRATION_BATCH_SIZE:100}

aws:
  region: ${AWS_REGION:ap-northeast-2}
  s3:
    image-bucket: ${S3_IMAGE_BUCKET:}
    upload-url-expiration: ${S3_IMAGE_UPLOAD_URL_EXPIRATION:5m}
    get-url-expiration: ${S3_IMAGE_GET_URL_EXPIRATION:5m}

logging:
  level:
    org.hibernate.SQL: debug
